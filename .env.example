# Salin ke `.env.local` untuk pengembangan lokal. JANGAN commit `.env`.
#
# PENTING (brief §9.2): nilai ini di-BAKE saat build, bukan dibaca saat runtime.
# Mengubahnya di dashboard Vercel tidak berefek sampai ada REDEPLOY.
#
# Hanya ANON key. Jangan pernah menaruh `service_role` di sini — seluruh isi
# file ini ikut terbundel ke JS publik dan bisa dibaca siapa pun. Keamanan
# nyata satu-satunya adalah RLS di Supabase (lihat supabase/schema.sql).
#
# Kosongkan keduanya kalau ingin memakai Qnote 100% lokal tanpa sync —
# app tetap berfungsi penuh.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
