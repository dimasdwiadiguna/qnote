{"surah":104,"name_arabic":"الهمزة","name_latin":"Al-Humazah","name_id":"Pengumpat","ayah_count":9,"ayat":[{"number":1,"arabic":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","translation_id":"Celakalah bagi setiap pengumpat dan pencela,"},{"number":2,"arabic":"ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","translation_id":"yang mengumpulkan harta dan menghitung-hitungnya,"},{"number":3,"arabic":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","translation_id":"dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya."},{"number":4,"arabic":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","translation_id":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah."},{"number":5,"arabic":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","translation_id":"Dan tahukah kamu apakah (neraka) Hutamah itu?"},{"number":6,"arabic":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","translation_id":"(Yaitu) api  (azab) Allah yang dinyalakan,"},{"number":7,"arabic":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","translation_id":"yang (membakar) sampai ke hati."},{"number":8,"arabic":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","translation_id":"Sungguh, api itu ditutup rapat atas (diri) mereka,"},{"number":9,"arabic":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","translation_id":"(sedang mereka itu) diikat pada tiang-tiang yang panjang."}]}