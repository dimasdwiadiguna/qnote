{"surah":94,"name_arabic":"الشرح","name_latin":"Asy-Syarh","name_id":"Lapang","ayah_count":8,"ayat":[{"number":1,"arabic":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","translation_id":"Bukankah Kami telah melapangkan dadamu (Muhammad)?"},{"number":2,"arabic":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","translation_id":"dan Kami pun telah menurunkan bebanmu darimu,"},{"number":3,"arabic":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","translation_id":"yang memberatkan punggungmu,"},{"number":4,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","translation_id":"dan Kami tinggikan sebutan (nama)mu bagimu."},{"number":5,"arabic":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","translation_id":"Maka sesungguhnya beserta kesulitan ada kemudahan,"},{"number":6,"arabic":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","translation_id":"sesungguhnya beserta kesulitan itu ada kemudahan."},{"number":7,"arabic":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","translation_id":"Maka apabila engkau telah selesai (dari sesuatu urusan), tetaplah bekerja keras (untuk urusan yang lain),"},{"number":8,"arabic":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","translation_id":"dan hanya kepada Tuhanmulah engkau berharap."}]}