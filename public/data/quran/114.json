{"surah":114,"name_arabic":"الناس","name_latin":"An-Nas","name_id":"Manusia","ayah_count":6,"ayat":[{"number":1,"arabic":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","translation_id":"Katakanlah, “Aku berlindung kepada Tuhannya manusia,"},{"number":2,"arabic":"مَلِكِ النَّاسِۙ","translation_id":"Raja manusia,"},{"number":3,"arabic":"اِلٰهِ النَّاسِۙ","translation_id":"sembahan manusia,"},{"number":4,"arabic":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","translation_id":"dari kejahatan (bisikan) setan yang bersembunyi,"},{"number":5,"arabic":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","translation_id":"yang membisikkan (kejahatan) ke dalam dada manusia,"},{"number":6,"arabic":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ","translation_id":"dari (golongan) jin dan manusia.”"}]}